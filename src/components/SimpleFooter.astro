---
import site from '../data/site.json';
const hours = site.hours.map((h) => `${h.label.toLowerCase()} ${h.text}`).join(', ');
---
<footer class="container footer-simple">
  <span class="footer-logo">Cakes by <em>Clara</em></span>
  <span>
    {site.street}, {site.city} · {hours.charAt(0).toUpperCase() + hours.slice(1)} ·
    <a href={site.phoneHref}>{site.phone}</a>
  </span>
</footer>
