---
import { url } from '../lib/url';
import Logo from './Logo.astro';

interface Props {
  page: 'home' | 'galleri' | 'brollop';
}
const { page } = Astro.props;
const home = page === 'home' ? '' : url('/');

const links = [
  { href: url('galleri/'), label: 'Galleri', current: page === 'galleri' },
  { href: url('brollop/'), label: 'Bröllop', current: page === 'brollop' },
  ...(page === 'home' ? [{ href: '#bestall', label: 'Beställ' }] : []),
  { href: `${home}#fragor`, label: 'Frågor' },
  { href: `${home}#om`, label: 'Om Clara' },
  { href: `${home}#hitta`, label: 'Hitta hit' },
];
const cta =
  page === 'brollop'
    ? { href: '#provsmakning', label: 'Boka provsmakning' }
    : { href: `${home}#formular`, label: 'Beställ tårta' };
---
<div class="header-bar" id="header-bar">
<header class="container site-header">
  <Logo />
  <nav class="nav" aria-label="Huvudmeny">
    {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    <a href={cta.href} class="nav-cta">{cta.label}</a>
  </nav>
  <button class="menu-btn" type="button" aria-label="Meny" aria-expanded="false" aria-controls="mobilmeny">
    <span></span><span></span><span></span>
  </button>
  <nav id="mobilmeny" class="mobile-nav" aria-label="Mobilmeny" hidden>
    {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    <a href={cta.href} class="nav-cta">{cta.label}</a>
  </nav>
</header>
</div>

<script>
  // Menyn ligger kvar överst vid scrollning. Dess höjd sparas i --header-h så att
  // ankarlänkar och galleriets filterrad hamnar under den i stället för bakom.
  const bar = document.getElementById('header-bar');
  if (bar) {
    const setHeight = () => document.documentElement.style.setProperty('--header-h', `${bar.offsetHeight}px`);
    new ResizeObserver(setHeight).observe(bar);
    setHeight();
    const onScroll = () => bar.classList.toggle('scrolled', window.scrollY > 4);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobilmeny');
  if (btn && menu) {
    const set = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => set(menu.hidden));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    window.matchMedia('(min-width: 860px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>
