---
import Base from '../layouts/Base.astro';
import SimpleFooter from '../components/SimpleFooter.astro';
import cakes from '../data/cakes.json';
import sizes from '../data/sizes.json';
import { img, url } from '../lib/url';

const cats = ['Alla', 'Klassiker', 'Fruktiga', 'Choklad', 'Barnkalas', 'Säsong'];
const diets = ['glutenfri', 'laktosfri', 'vegansk'];
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const orderHref = (name: string) => `${url('/')}?tarta=${encodeURIComponent(name)}#formular`;
---
<Base
  page="sortiment"
  title="Sortiment – Cakes by Clara"
  description="Alla tårtor från Cakes by Clara i Mariestad. Klassiker, fruktiga tårtor, choklad, barnkalas och säsongens tårtor – många kan bakas glutenfria, laktosfria eller veganska."
>
  <section class="container stack intro">
    <p class="eyebrow">Sortiment</p>
    <h1 class="h1 title">Alla tårtor, bakade på beställning</h1>
    <p class="lead">Priserna gäller för 8 personer. Alla tårtor finns i fler storlekar, och de flesta kan bakas glutenfria, laktosfria eller veganska.</p>
  </section>

  <section class="container stack filters" aria-label="Filtrera tårtor">
    <div class="chips" role="group" aria-label="Kategori">
      {cats.map((c, i) => <button type="button" class="chip" data-cat={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
    </div>
    <div class="chips diets" role="group" aria-label="Specialkost">
      <span>Specialkost:</span>
      {diets.map((d) => <button type="button" class="chip diet" data-diet={d} aria-pressed="false">{cap(d)}</button>)}
    </div>
  </section>

  <section class="container results">
    <div class="grid cake-grid" id="cake-grid">
      {cakes.map((c) => (
        <article class="stack cake" data-cat={c.cat} data-diets={c.diets.join(' ')}>
          <div class="img-frame tall">
            <img src={img(c.img, 900)} alt={c.name} loading="lazy" />
            {c.badge && <span class="badge">{c.badge}</span>}
          </div>
          <div class="cake-head">
            <h2>{c.name}</h2>
            <span class="price">från {c.price} kr</span>
          </div>
          <p class="desc">{c.desc}</p>
          <div class="tags">{c.diets.map((d) => <span class="tag">Kan bli {d}</span>)}</div>
          <a href={orderHref(c.name)} class="btn btn-primary btn-sm order-btn" data-order>Beställ den här</a>
        </article>
      ))}
    </div>
    <div class="stack empty" id="no-results" hidden>
      <p class="empty-title">Ingen tårta matchar just den kombinationen.</p>
      <p class="muted">Skicka en förfrågan ändå, så ser jag vad som går att göra.</p>
      <button type="button" class="btn btn-outline btn-sm" id="clear-filters">Rensa filter</button>
    </div>
  </section>

  <section class="band bg-alt band-96">
    <div class="inner split">
      <div class="stack split-text">
        <h2 class="h2 small-h2">Storlekar</h2>
        <p class="muted">Priset räknas från grundpriset för 8 personer. Dekor, text och figurer offereras separat.</p>
      </div>
      <div class="table">
        {sizes.map((s) => (
          <div class="table-row"><span>{s.people}</span><span class="muted">{s.size}</span><span>{s.price}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="container cta">
    <h2 class="h2 cta-title">Hittar du inte rätt? Berätta din idé så bakar jag den.</h2>
    <a href={`${url('/')}#formular`} class="btn btn-primary">Skicka en förfrågan</a>
  </section>

  <SimpleFooter slot="footer" />
</Base>

<script>
  const catButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-cat].chip')];
  const dietButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-diet]')];
  const cards = [...document.querySelectorAll<HTMLElement>('article.cake')];
  const grid = document.getElementById('cake-grid')!;
  const empty = document.getElementById('no-results')!;
  const orderLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[data-order]')];

  let cat = 'Alla';
  let diets: string[] = [];

  function render() {
    catButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
    dietButtons.forEach((b) => b.setAttribute('aria-pressed', String(diets.includes(b.dataset.diet!))));
    let shown = 0;
    cards.forEach((card) => {
      const cakeDiets = (card.dataset.diets || '').split(' ');
      const visible = (cat === 'Alla' || card.dataset.cat === cat) && diets.every((d) => cakeDiets.includes(d));
      card.hidden = !visible;
      if (visible) shown++;
    });
    grid.hidden = shown === 0;
    empty.hidden = shown !== 0;

    // Vald specialkost följer med till beställningsformuläret: ?tarta=…&kost=glutenfri,vegansk
    orderLinks.forEach((a) => {
      const link = new URL(a.href);
      if (diets.length) link.searchParams.set('kost', diets.join(','));
      else link.searchParams.delete('kost');
      a.href = link.toString();
    });
  }

  catButtons.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.cat!; render(); }));
  dietButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const d = b.dataset.diet!;
      diets = diets.includes(d) ? diets.filter((x) => x !== d) : [...diets, d];
      render();
    }),
  );
  document.getElementById('clear-filters')?.addEventListener('click', () => { cat = 'Alla'; diets = []; render(); });
</script>

<style>
  .intro { padding-top: 48px; padding-bottom: 40px; gap: 20px; }
  .title { font-size: clamp(48px, 6vw, 80px); max-width: 820px; }
  .intro .lead { font-size: 18px; max-width: 600px; }

  .filters { position: sticky; top: var(--header-h, 0px); z-index: 5; background: var(--bg); padding-top: 16px; padding-bottom: 16px; gap: 14px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .diets { font-size: 14px; color: var(--ink-3); }
  .diets > span { margin-right: 4px; }
  .chip {
    min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--line-strong);
    background: transparent; color: var(--ink); font-size: 15px; cursor: pointer;
  }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .chip.diet { padding: 0 14px; font-size: 14px; border-style: dashed; }
  .chip.diet[aria-pressed='true'] { background: var(--bg-strong); color: var(--ink); border-color: var(--accent); }

  .results { padding-top: 16px; padding-bottom: 112px; }
  .cake-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: 40px 28px; }
  .cake { gap: 12px; }
  .tall { aspect-ratio: 4 / 5; background: var(--line); }
  .badge { position: absolute; top: 12px; left: 12px; background: var(--bg); padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 500; }
  .cake-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .cake-head h2 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 26px; }
  .price { font-size: 15px; font-weight: 500; color: var(--ink-muted); white-space: nowrap; }
  .desc { margin: 0; font-size: 15px; line-height: 1.5; color: var(--ink-3); }
  .order-btn { margin-top: 4px; align-self: flex-start; }

  .empty { padding: 64px 0; gap: 16px; align-items: flex-start; }
  .empty p { margin: 0; font-size: 16px; }
  .empty .empty-title { font-family: var(--serif); font-size: 32px; }

  .band-96 { padding-top: 96px; padding-bottom: 96px; }
  .split { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; }
  .split-text { flex: 1 1 300px; gap: 16px; }
  .split-text p { margin: 0; font-size: 16px; line-height: 1.55; max-width: 380px; }
  .small-h2 { font-size: clamp(36px, 4.5vw, 52px); }

  .cta { padding-top: 96px; padding-bottom: 96px; display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: center; }
  .cta-title { font-size: clamp(32px, 4vw, 48px); line-height: 1.05; max-width: 620px; }
</style>
