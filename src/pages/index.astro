---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import site from '../data/site.json';
import cakes from '../data/cakes.json';
import seasonal from '../data/seasonal.json';
import order from '../data/order.json';
import faqs from '../data/faq.json';
import reviews from '../data/reviews.json';
import { img, url } from '../lib/url';

const favorites = cakes.filter((c) => c.favorite);
// Rekommenderade kombinationer: favoriterna, plus säsongens tårta när den sektionen visas
const combos = cakes
  .filter((c) => c.favorite || (site.show.seasonal && c.name === seasonal.cake))
  .map((c) => ({ name: c.name, bottom: c.bottom, fillings: c.fillings }));
// Alla tårtors botten och fyllningar, så att "Beställ den här" i sortimentet kan förvälja dem
const allCombos = cakes.map((c) => ({ name: c.name, bottom: c.bottom, fillings: c.fillings }));
const diets = ['Glutenfri', 'Laktosfri', 'Vegansk', 'Nötfri'];
const styles = ['Låt Clara föreslå', 'Vintage', 'Klassisk', 'Blommor', 'Tema'];
const steps = [
  { title: 'Skicka en förfrågan', text: 'Välj en favorit eller beskriv din idé. Ange datum, antal personer och eventuella allergier.' },
  { title: 'Jag bekräftar', text: 'Inom ett dygn får du förslag, pris och hämttid.' },
  { title: 'Hämta eller få levererat', text: 'Hämta i butiken eller få tårtan levererad inom Mariestad.' },
];
const gallery = [
  { id: '1535254973040-607b474cb50d', alt: 'Bröllopstårta i tre våningar' },
  { id: '1558636508-e0db3814bd1d', alt: 'Barnkalastårta' },
  { id: '1563729784474-d77dbb933a9e', alt: 'Detalj, sockerblommor' },
  { id: '1621303837174-89787a7d4729', alt: 'Doptårta' },
  { id: '1519225421980-715cb0215aed', alt: 'Tårtbord på fest' },
];
const insta = [
  'Spindelmannentårta i rött och blått',
  'Ninjatårta i turkos',
  'Två små tårtor med spritsad dekor',
  'Siffertårta med blommor, hallon och maränger',
  'Chokladtårta med spritsad dekor och pärlor',
  'Tårta i rosa och lila med K-pop-tema',
].map((alt, i) => ({ src: `images/insta-${i + 1}.webp`, alt }));
const [weekdays, saturday] = site.hours;
---
<Base
  page="home"
  title="Cakes by Clara – handgjorda tårtor på beställning i Mariestad"
  description="Tårtbageri i Mariestad. Tårtor på beställning för födelsedagar, kalas och bröllop – med svenskt smör, säsongens bär och riktig vanilj."
>
  <section class="container hero grid">
    <div class="stack hero-text">
      <p class="eyebrow">Handgjorda tårtor på beställning</p>
      <h1 class="h1">Tårtor för dagar man vill <em>minnas</em></h1>
      <p class="lead">Jag bakar varje tårta på beställning, med svenskt smör, säsongens bär och riktig vanilj. Berätta vad du firar så hjälper jag dig med resten.</p>
      <div class="btn-row">
        <a href="#formular" class="btn btn-primary">Beställ tårta</a>
        <a href="#tartor" class="btn btn-outline">Se sortimentet</a>
      </div>
    </div>
    <div class="img-frame hero-img">
      <img src={img('1581745069539-1e60d7f965f4', 1600)} alt="Vit tårta med rosa rosor" fetchpriority="high" />
      <a class="credit" href="https://unsplash.com/photos/white-cake-with-pink-roses-on-top-7c4dM_jyxz0">Foto: David Holifield / Unsplash</a>
    </div>
  </section>

  <section id="hitta" class="container info-section">
    <div class="info grid">
      <div class="stack"><span class="label">Öppet idag</span><span id="oppet-idag" data-hours={JSON.stringify(site.hours)}>{weekdays.text}</span></div>
      <div class="stack"><span class="label">{weekdays.label} / {saturday.label.toLowerCase()}</span><span>{weekdays.text} / {saturday.text}</span></div>
      <div class="stack"><span class="label">Adress</span><a href={site.mapsUrl}>{site.street}, {site.city}</a></div>
      <div class="stack"><span class="label">Telefon</span><a href={site.phoneHref}>{site.phone}</a></div>
    </div>
  </section>

  {site.show.seasonal && (
    <section class="container seasonal-section">
      <div class="seasonal grid">
        <div class="img-frame seasonal-img"><img src={img(seasonal.img)} alt={seasonal.alt} loading="lazy" /></div>
        <div class="stack seasonal-text">
          <p class="eyebrow">{seasonal.eyebrow}</p>
          <h2 class="h2 seasonal-title">{seasonal.title}</h2>
          <p class="seasonal-body">{seasonal.text}</p>
          <a href={`?tarta=${encodeURIComponent(seasonal.cake)}#formular`} class="btn btn-primary btn-md">{seasonal.cta}</a>
        </div>
      </div>
    </section>
  )}

  <section id="tartor" class="band bg-alt band-96">
    <div class="inner stack gap-40">
      <div class="section-head">
        <h2 class="h2">Kundernas favoriter</h2>
        <a href={url('sortiment/')} class="text-link">Hela sortimentet →</a>
      </div>
      <p class="muted small-intro">De flesta tårtor kan bakas glutenfria, laktosfria eller veganska. Ange allergier i beställningen så anpassar jag. Bageriet hanterar nötter.</p>
      <div class="grid cards" style="--min:250px">
        {favorites.map((c) => (
          <article class="stack card">
            <div class="img-frame square"><img src={img(c.img)} alt={c.name} loading="lazy" /></div>
            <div class="card-head">
              <h3>{c.name}</h3>
              <span class="price">från {c.price} kr</span>
            </div>
            <p class="card-desc">{c.favoriteDesc ?? c.desc}</p>
            <div class="tags">{c.favoriteTags?.map((t) => <span class="tag">{t}</span>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="galleri" class="container stack gallery-section">
    <div class="section-head">
      <h2 class="h2">Bröllop & fester</h2>
      <a href={url('brollop/')} class="text-link">Bröllopstårtor →</a>
    </div>
    <div class="grid gallery" style="--min:280px">
      {gallery.map((g) => <div class="img-frame"><img src={img(g.id)} alt={g.alt} loading="lazy" /></div>)}
    </div>
  </section>

  <section id="bestall" class="band bg-alt">
    <div class="inner grid order" style="--min:400px">
      <div class="stack gap-40">
        <h2 class="h2">Så beställer du</h2>
        <ol class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="step-n">{i + 1}</span>
              <div class="stack">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="stack delivery">
          <strong>Leverans</strong>
          <span>{site.delivery}</span>
        </div>
      </div>

      <div id="formular" class="form-card">
        <form class="form" id="order-form" data-endpoint={site.formEndpoint || undefined}>
          <h3 class="form-title">Skicka en förfrågan</h3>
          <input type="hidden" name="_subject" value="Ny tårtbeställning" />
          <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="grid form-grid">
            <label class="field">Namn<input required name="Namn" autocomplete="name" /></label>
            <label class="field">E-post eller telefon<input required name="Kontakt" autocomplete="email" /></label>
            <label class="field">Datum<input required type="date" name="Datum" id="order-date" /></label>
            <label class="field">Antal personer
              <select name="Antal personer">
                <option>6–8</option><option>10–12</option><option>15–20</option><option>25–40</option><option>Fler än 40</option>
              </select>
            </label>
          </div>
          <fieldset>
            <legend>Rekommenderade kombinationer</legend>
            <div class="combos" id="combos" data-combos={JSON.stringify(allCombos)}>
              {combos.map((c) => (
                <button type="button" class="combo" data-combo={c.name} aria-pressed="false">
                  <span class="combo-name">{c.name}</span>
                  <span class="combo-detail">{c.bottom}botten · {c.fillings.join(', ')}</span>
                </button>
              ))}
            </div>
            <input type="hidden" name="Kombination" id="combo-field" value="Egen kombination" />
          </fieldset>
          <label class="field">Tårtbotten
            <select name="Tårtbotten" id="bottom-select">
              {order.bottoms.map((o) => <option value={o}>{o}</option>)}
            </select>
          </label>
          <fieldset id="fillings" data-max={order.maxFillings}>
            <legend>Fyllning <span class="legend-hint">välj 1–{order.maxFillings}</span></legend>
            <div class="pills">
              {order.fillings.map((f) => <label class="pill"><input type="checkbox" name="Fyllning" value={f} />{f}</label>)}
            </div>
          </fieldset>
          <fieldset>
            <legend>Stil</legend>
            <div class="pills">
              {styles.map((st, i) => <label class="pill"><input type="radio" name="Stil" value={st} checked={i === 0} />{st}</label>)}
            </div>
          </fieldset>
          <fieldset>
            <legend>Specialkost</legend>
            <div class="pills">
              {diets.map((d) => <label class="pill"><input type="checkbox" name="Specialkost" value={d} />{d}</label>)}
            </div>
          </fieldset>
          <fieldset>
            <legend>Hämtning eller leverans</legend>
            <div class="pills">
              <label class="pill"><input type="radio" name="Hämtning eller leverans" value="Hämtar i butiken" checked />Hämtar i butiken</label>
              <label class="pill"><input type="radio" name="Hämtning eller leverans" value="Leverans" />Leverans</label>
            </div>
          </fieldset>
          <fieldset class="delivery-fields" id="delivery-fields" hidden disabled>
            <legend>Leveransadress</legend>
            <label class="field">Gatuadress<input required name="Leveransadress" autocomplete="street-address" /></label>
            <div class="grid form-grid">
              <label class="field">Postnummer<input required name="Postnummer" inputmode="numeric" autocomplete="postal-code" /></label>
              <label class="field">Ort<input required name="Ort" autocomplete="address-level2" value={site.city} /></label>
            </div>
            <p class="form-note">{site.delivery}</p>
          </fieldset>
          <label class="field">Önskemål och allergier<textarea name="Önskemål och allergier" rows="4" placeholder="Färger, text på tårtan, tema, allergier…"></textarea></label>
          <button type="submit" class="submit">Skicka förfrågan</button>
          <p class="form-error" hidden>Något gick fel. Försök igen eller ring {site.phone}.</p>
          <p class="form-note">Du får svar inom ett dygn. Förfrågan är inte bindande.</p>
        </form>
        <div class="thanks" id="order-thanks" hidden>
          <h3>Tack, <span id="thanks-name"></span>!</h3>
          <p>Jag har fått din förfrågan och återkommer inom ett dygn med förslag och pris.</p>
          <button type="button" class="btn btn-outline btn-sm" id="order-again">Skicka en till</button>
        </div>
      </div>
    </div>
  </section>

  <section class="container grid reviews" style="--min:320px">
    {reviews.map((r) => (
      <figure class="stack">
        <blockquote>”{r.quote}”</blockquote>
        <figcaption>{r.name}</figcaption>
      </figure>
    ))}
  </section>

  <section id="fragor" class="container faq-section">
    <h2 class="h2 faq-title">Vanliga frågor</h2>
    <div class="faq">
      {faqs.map((f, i) => (
        <div class="faq-item">
          <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-${i}`}>
            <span>{f.q}</span>
            <span class="faq-sign" aria-hidden="true">{i === 0 ? '−' : '+'}</span>
          </button>
          <p id={`faq-${i}`} hidden={i !== 0}>{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="om" class="band bg-strong">
    <div class="inner grid about" style="--min:380px">
      <div class="img-frame about-img">
        <img src={url('images/clara.webp')} alt="Clara, som driver Cakes by Clara" width="505" height="505" loading="lazy" />
      </div>
      <div class="stack about-text">
        <h2 class="h2">Hej, jag heter Clara</h2>
        <p>Jag älskar att baka tårtor – att hitta smaker som passar ihop, forma dekorationer för hand och se glädjen när en tårta bärs fram. Därför öppnade jag Cakes by Clara. Allt bakas i mitt bageri från grunden, och varje tårta formges tillsammans med dig.</p>
        <a href="#om" class="text-link">Läs mer om mig</a>
      </div>
    </div>
  </section>

  {site.show.instagram && (
    <section class="container stack insta-section">
      <div class="section-head">
        <h2 class="h2 insta-title">Senast från bageriet</h2>
        {site.instagramUrl && <a href={site.instagramUrl} class="text-link">{site.instagramHandle} på Instagram →</a>}
      </div>
      <div class="insta">
        {insta.map((p) => (
          <div class="img-frame"><img src={img(p.src, 600)} alt={p.alt} loading="lazy" /></div>
        ))}
      </div>
    </section>
  )}

  <footer slot="footer" class="container stack big-footer">
    <div class="grid footer-cols" style="--min:220px">
      <div><Logo class="footer-logo" /></div>
      <div class="stack"><strong>Besök</strong><span>{site.street}</span><span>{site.postalCode} {site.city}</span></div>
      <div class="stack">
        <strong>Öppettider</strong>
        {site.hours.map((h) => <span>{h.label} {h.text}</span>)}
        <span>{site.closedText}</span>
      </div>
      <div class="stack">
        <strong>Kontakt</strong>
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.instagramUrl && <a href={site.instagramUrl}>Instagram</a>}
      </div>
    </div>
    <p class="copyright">© {new Date().getFullYear()} Cakes by Clara</p>
  </footer>
</Base>

<script>
  import { setupForm } from '../lib/forms';

  // "Öppet idag" utifrån veckodag och öppettiderna i site.json
  const today = document.getElementById('oppet-idag');
  if (today?.dataset.hours) {
    const day = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'][new Date().getDay()];
    const hours: { days: string[]; text: string }[] = JSON.parse(today.dataset.hours);
    today.textContent = hours.find((h) => h.days.includes(day))?.text ?? 'Stängt';
  }

  // Datum kan inte väljas bakåt i tiden
  const date = document.querySelector<HTMLInputElement>('#order-date');
  if (date) date.min = new Date().toISOString().slice(0, 10);

  // Förvald tårta och specialkost från sortimentet: /?tarta=Namn&kost=glutenfri,vegansk#formular
  const params = new URLSearchParams(location.search);
  const kost = (params.get('kost') || '').toLowerCase().split(',').filter(Boolean);
  document.querySelectorAll<HTMLInputElement>('#order-form input[name="Specialkost"]').forEach((box) => {
    if (kost.includes(box.value.toLowerCase())) box.checked = true;
  });

  // Kombinationer av botten och fyllningar
  type Combo = { name: string; bottom: string; fillings: string[] };
  const comboBox = document.getElementById('combos')!;
  const allCombos: Combo[] = JSON.parse(comboBox.dataset.combos || '[]');
  const comboField = document.querySelector<HTMLInputElement>('#combo-field')!;
  const bottomSelect = document.querySelector<HTMLSelectElement>('#bottom-select')!;
  const fillingSet = document.getElementById('fillings')!;
  const fillingBoxes = [...fillingSet.querySelectorAll<HTMLInputElement>('input[name="Fyllning"]')];
  const maxFillings = Number(fillingSet.dataset.max) || 3;
  let active: Combo | null = null;

  const comboButtons = () => [...comboBox.querySelectorAll<HTMLButtonElement>('.combo')];
  const chosen = () => fillingBoxes.filter((b) => b.checked).map((b) => b.value);

  // Max tre fyllningar, minst en
  function updateFillings() {
    const n = chosen().length;
    fillingBoxes.forEach((b) => (b.disabled = !b.checked && n >= maxFillings));
    fillingBoxes[0].setCustomValidity(n === 0 ? `Välj 1–${maxFillings} fyllningar` : '');
  }

  function markActive(c: Combo | null) {
    active = c;
    comboField.value = c ? c.name : 'Egen kombination';
    comboButtons().forEach((b) => b.setAttribute('aria-pressed', String(!!c && b.dataset.combo === c.name)));
  }

  function applyCombo(c: Combo) {
    bottomSelect.value = c.bottom;
    fillingBoxes.forEach((b) => (b.checked = c.fillings.includes(b.value)));
    updateFillings();
    markActive(c);
  }

  comboBox.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.combo');
    const c = btn && allCombos.find((x) => x.name === btn.dataset.combo);
    if (c) applyCombo(c);
  });

  // Ändrar kunden själv blir det en egen kombination
  function onManualChange() {
    updateFillings();
    if (!active) return;
    const same = bottomSelect.value === active.bottom &&
      chosen().length === active.fillings.length && active.fillings.every((f) => chosen().includes(f));
    if (!same) markActive(null);
  }
  bottomSelect.addEventListener('change', onManualChange);
  fillingBoxes.forEach((b) => b.addEventListener('change', onManualChange));
  updateFillings();

  // Förvald tårta från sortimentet: visas som kombination även om den inte finns bland de rekommenderade
  const wanted = params.get('tarta');
  const wantedCombo = wanted && allCombos.find((c) => c.name === wanted);
  if (wantedCombo) {
    if (!comboButtons().some((b) => b.dataset.combo === wantedCombo.name)) {
      const btn = comboButtons()[0].cloneNode(true) as HTMLButtonElement;
      btn.dataset.combo = wantedCombo.name;
      btn.querySelector('.combo-name')!.textContent = wantedCombo.name;
      btn.querySelector('.combo-detail')!.textContent = `${wantedCombo.bottom}botten · ${wantedCombo.fillings.join(', ')}`;
      comboBox.prepend(btn);
    }
    applyCombo(wantedCombo);
  }
  if (wanted) {
    const card = document.getElementById('formular');
    setTimeout(() => card?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 300);
  }

  // Beställningsformulär
  const form = document.querySelector<HTMLFormElement>('#order-form');
  const thanks = document.getElementById('order-thanks');
  const nameEl = document.getElementById('thanks-name');
  if (form && thanks && nameEl) {
    setupForm(form, (data) => {
      nameEl.textContent = String(data.get('Namn') || '').trim().split(' ')[0];
      form.hidden = true;
      thanks.hidden = false;
    });
    document.getElementById('order-again')?.addEventListener('click', () => {
      form.reset();
      markActive(null);
      updateFillings();
      form.hidden = false;
      thanks.hidden = true;
    });
  }

  // Leveransadress visas och krävs bara vid leverans (inaktiverade fält skickas inte)
  const deliveryFields = document.querySelector<HTMLFieldSetElement>('#delivery-fields');
  const deliveryRadios = [...document.querySelectorAll<HTMLInputElement>('input[name="Hämtning eller leverans"]')];
  const updateDelivery = () => {
    if (!deliveryFields) return;
    const on = deliveryRadios.some((r) => r.checked && r.value === 'Leverans');
    deliveryFields.hidden = !on;
    deliveryFields.disabled = !on;
  };
  deliveryRadios.forEach((r) => r.addEventListener('change', updateDelivery));
  form?.addEventListener('reset', () => setTimeout(updateDelivery));
  updateDelivery();

  // FAQ: en fråga öppen åt gången
  const items = [...document.querySelectorAll<HTMLElement>('.faq-item')];
  const setOpen = (item: HTMLElement, open: boolean) => {
    item.querySelector('button')!.setAttribute('aria-expanded', String(open));
    item.querySelector('p')!.hidden = !open;
    item.querySelector('.faq-sign')!.textContent = open ? '−' : '+';
  };
  items.forEach((item) =>
    item.querySelector('button')!.addEventListener('click', () => {
      const wasOpen = item.querySelector('button')!.getAttribute('aria-expanded') === 'true';
      items.forEach((i) => setOpen(i, false));
      if (!wasOpen) setOpen(item, true);
    }),
  );
</script>

<style>
  .hero { --min: 420px; gap: 56px; align-items: center; padding-top: 40px; padding-bottom: 72px; }
  .hero-text { gap: 28px; }
  .hero-img { aspect-ratio: 4 / 5; border-radius: 220px 220px 16px 16px; }
  .credit {
    position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); font-size: 11px;
    background: rgba(252, 245, 245, 0.85); padding: 4px 10px; border-radius: 999px; white-space: nowrap;
  }

  .info-section { padding-bottom: 72px; }
  .info { --min: 220px; gap: 20px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 22px 0; font-size: 15px; }
  .info .stack { gap: 4px; }

  .seasonal-section { padding-bottom: 96px; }
  .seasonal { --min: 360px; background: var(--bg-strong); border-radius: 24px; overflow: hidden; }
  .seasonal-img { min-height: 320px; border-radius: 0; background: #ecccd2; }
  .seasonal-text { padding: 48px; gap: 20px; justify-content: center; }
  .seasonal-text .eyebrow { color: var(--ink-3); }
  .seasonal-title { font-size: clamp(36px, 4vw, 52px); }
  .seasonal-body { margin: 0; font-size: 17px; line-height: 1.55; color: var(--ink-2); max-width: 440px; }
  .btn-md { padding: 14px 24px; font-size: 15px; align-self: flex-start; }

  .band-96 { padding-top: 96px; padding-bottom: 96px; }
  .gap-40 { gap: 40px; }
  .small-intro { margin: 0; font-size: 15px; line-height: 1.55; max-width: 640px; }
  .cards { gap: 28px; }
  .card { gap: 14px; }
  .square { aspect-ratio: 1; background: var(--line); }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .card-head h3 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 26px; }
  .price { font-size: 15px; font-weight: 500; color: var(--ink-muted); white-space: nowrap; }
  .card-desc { margin: 0; font-size: 15px; line-height: 1.5; color: var(--ink-3); }

  .gallery-section { padding-top: 112px; padding-bottom: 112px; gap: 48px; }
  .gallery { grid-auto-rows: 260px; gap: 16px; }
  .gallery > :first-child { grid-row: span 2; }

  .order { gap: 64px; align-items: start; }
  .steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 28px; }
  .steps li { display: grid; grid-template-columns: 48px 1fr; gap: 16px; border-top: 1px solid var(--ink); padding-top: 20px; }
  .steps .stack { gap: 8px; }
