---
import Base from '../layouts/Base.astro';
import SimpleFooter from '../components/SimpleFooter.astro';
import site from '../data/site.json';
import wedding from '../data/wedding.json';
import { img, url } from '../lib/url';

const gallery = [
  { id: '1535254973040-607b474cb50d', alt: 'Bröllopstårta i tre våningar' },
  { id: '1519225421980-715cb0215aed', alt: 'Tårtbord på bröllop' },
  { id: '1563729784474-d77dbb933a9e', alt: 'Detalj med sockerblommor' },
  { id: '1621303837174-89787a7d4729', alt: 'Bröllopstårta med blommor' },
];
---
<Base
  page="brollop"
  title="Bröllopstårtor – Cakes by Clara"
  description="Bröllopstårtor från Cakes by Clara i Mariestad. Provsmakning, skiss och offert – tårtan formges från grunden tillsammans med er."
>
  <section class="container grid hero">
    <div class="img-frame hero-img">
      <img src={url('images/brollop-hero.webp')} alt="Vit bröllopstårta i fyra våningar med rosa och vita rosor" width="720" height="900" fetchpriority="high" />
    </div>
    <div class="stack hero-text">
      <p class="eyebrow">Bröllopstårtor</p>
      <h1 class="h1 title">En tårta som är <em>er</em></h1>
      <p class="lead">Varje bröllopstårta formges från grunden tillsammans med er. Vi börjar med en provsmakning i bageriet och bygger sedan tårtan kring era smaker, er färgskala och er dag.</p>
      <div class="btn-row">
        <a href="#provsmakning" class="btn btn-primary">Boka provsmakning</a>
        <a href="#priser" class="btn btn-outline">Se priser</a>
      </div>
    </div>
  </section>

  <section class="band bg-alt">
    <div class="inner stack gap-56">
      <h2 class="h2">Från provsmakning till tårtbord</h2>
      <ol class="grid process">
        {wedding.process.map((p) => (
          <li class="stack">
            <span class="label when">{p.when}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container stack gallery-section">
    <h2 class="h2">Tidigare bröllop</h2>
    <div class="grid gallery">
      {gallery.map((g) => <div class="img-frame"><img src={img(g.id)} alt={g.alt} loading="lazy" /></div>)}
    </div>
    <figure class="stack quote">
      <blockquote>”Clara lyssnade på varje litet önskemål och tårtan blev ännu vackrare än vi hade föreställt oss. Gästerna pratade om smaken hela kvällen.”</blockquote>
      <figcaption>Elin & Johan, gifte sig på en gård utanför Mariestad</figcaption>
    </figure>
  </section>

  <section id="priser" class="band bg-strong">
    <div class="inner split">
      <div class="stack split-text">
        <h2 class="h2">Priser</h2>
        <p>Riktpriser inklusive en enklare dekor. Sockerblommor, färska blommor och specialdesign offereras. Leverans och uppdukning i Mariestadsområdet från 495 kr.</p>
      </div>
      <div class="table prices">
        {wedding.prices.map((p) => (
          <div class="table-row"><span>{p.guests}</span><span class="ink-2">{p.tiers}</span><span>{p.price}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section id="provsmakning" class="container booking">
    <div class="stack booking-text">
      <h2 class="h2">Boka provsmakning</h2>
      <p class="muted">Ni smakar fyra smaker och vi pratar igenom design, storlek och leverans. Provsmakningen kostar 395 kr för två och dras av från tårtans pris när ni bokar.</p>
      <p class="hint">Boka gärna 3–9 månader innan bröllopet.</p>
    </div>
    <div class="form-card booking-card">
      <form class="form" id="tasting-form" data-endpoint={site.formEndpoint || undefined}>
        <input type="hidden" name="_subject" value="Bokning av provsmakning (bröllop)" />
        <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="grid form-grid">
          <label class="field">Era namn<input required name="namn" autocomplete="name" /></label>
          <label class="field">E-post eller telefon<input required name="kontakt" autocomplete="email" /></label>
          <label class="field">Bröllopsdatum<input required type="date" name="datum" id="wedding-date" /></label>
          <label class="field">Antal gäster
            <select name="gaster"><option>Upp till 40</option><option>40–70</option><option>70–100</option><option>Fler än 100</option></select>
          </label>
        </div>
        <label class="field">Plats och tankar om tårtan<textarea name="onskemal" rows="4" placeholder="Var ni gifter er, färger, stil, inspiration…"></textarea></label>
        <button type="submit" class="submit">Skicka förfrågan</button>
        <p class="form-error" hidden>Något gick fel. Försök igen eller ring {site.phone}.</p>
      </form>
      <div class="thanks" id="tasting-thanks" hidden>
        <h3>Grattis, och tack!</h3>
        <p>Jag hör av mig inom ett dygn med förslag på tider för provsmakning.</p>
      </div>
    </div>
  </section>

  <SimpleFooter slot="footer" />
</Base>

<script>
  import { setupForm } from '../lib/forms';

  const date = document.querySelector<HTMLInputElement>('#wedding-date');
  if (date) date.min = new Date().toISOString().slice(0, 10);

  const form = document.querySelector<HTMLFormElement>('#tasting-form');
  const thanks = document.getElementById('tasting-thanks');
  if (form && thanks) {
    setupForm(form, () => {
      form.hidden = true;
      thanks.hidden = false;
    });
  }
</script>

<style>
  .hero { --min: 420px; gap: 56px; align-items: center; padding-top: 32px; padding-bottom: 96px; }
  .hero-img { aspect-ratio: 4 / 5; border-radius: 16px; }
  .hero-text { gap: 28px; }
  .title { font-size: clamp(52px, 7vw, 92px); }
  .hero-text .lead { max-width: 480px; }

  .gap-56 { gap: 56px; }
  .process { --min: 240px; gap: 40px; list-style: none; margin: 0; padding: 0; }
  .process li { gap: 12px; border-top: 1px solid var(--ink); padding-top: 22px; }
  .when { font-size: 13px; }
  .process h3 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 30px; line-height: 1.05; }
  .process p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--ink-3); }

  .gallery-section { padding-top: 112px; padding-bottom: 112px; gap: 40px; }
  .gallery { --min: 280px; grid-auto-rows: 280px; gap: 16px; }
  .gallery > :first-child { grid-row: span 2; }
  .quote { margin: 24px 0 0; gap: 16px; max-width: 820px; }
  .quote blockquote { margin: 0; font-family: var(--serif); font-size: clamp(28px, 3.4vw, 40px); line-height: 1.2; text-wrap: pretty; }
  .quote figcaption { font-size: 14px; color: var(--ink-muted); }

  .split { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; }
  .split-text { flex: 1 1 300px; gap: 16px; }
  .split-text p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--ink-2); max-width: 380px; }
  .prices .table-row { padding: 20px 0; border-bottom-color: #dcb6bd; }
  .ink-2 { color: var(--ink-2); }

  .booking { padding-top: 112px; padding-bottom: 112px; display: flex; flex-wrap: wrap; gap: 64px; align-items: flex-start; }
  .booking-text { flex: 1 1 320px; gap: 20px; }
  .booking-text p { margin: 0; font-size: 17px; line-height: 1.6; max-width: 420px; }
  .booking-text .hint { font-size: 15px; color: var(--ink-muted); }
  .booking-card { flex: 1.3 1 420px; background: var(--bg-alt); }
  .thanks { padding: 16px 0; gap: 14px; }
</style>
